{
  "name": "stash-scout",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:frontend": "vite frontend --config frontend/vite.config.ts",
    "build:frontend": "vite build frontend --config frontend/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:dev-frontend": "DEV_INSTANCE=1 npm run build:frontend",
    "build": "npm run build:frontend && npm run build:server",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.3"
  }
}
