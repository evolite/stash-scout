{
  "name": "stashdb-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:frontend": "vite frontend --config frontend/vite.config.ts",
    "build:frontend": "vite build frontend --config frontend/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:frontend && npm run build:server",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
