PORT=8787

# Everything else (StashDB API key, local Stash URL/key, Whisparr URL/key/root
# folder/quality profile, Cloudflare Access credentials) is configured and
# tested from the app's Settings tab, not here — stored encrypted at rest in
# data/settings.json (key in data/.secret-key, both gitignored).

# Optional login (off by default). Normally set in Settings > Authentication;
# these only seed first boot. AUTH_MODE = off | local | oidc.
# If you lock yourself out, start once with AUTH_MODE_FORCE=off, then fix it in Settings.
# AUTH_MODE=local
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me
# OIDC_ISSUER=https://auth.example.com/realms/main
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED=you@example.com
